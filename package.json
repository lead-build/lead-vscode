{
  "name": "lead-build",
  "displayName": "Lead-build language",
  "description": "Lead declarative build environment language support",
  "publisher": "pengi",
  "icon": "images/icon.png",
  "license": "GPL-2.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/lead-build/lead-vscode.git"
  },
  "version": "0.9.1",
  "engines": {
    "vscode": "^1.121.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "lead-build.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "lead-build.restartLanguageServer",
        "title": "Lead-build: Restart Language Server"
      }
    ],
    "languages": [
      {
        "id": "pbb",
        "aliases": [
          "Lead build file",
          "pbb"
        ],
        "extensions": [
          ".pbb"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pbb",
        "scopeName": "source.lead-build",
        "path": "./syntaxes/pbb.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Lead-build language",
      "properties": {
        "pblang.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to the pbls language server binary. Leave empty to use 'pbls' from PATH."
        },
        "pblang.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Trace the communication between VS Code and the pbls language server."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.1",
    "@types/vscode": "^1.121.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "eslint": "^10.10.0",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "webpack": "^5.110.3",
    "webpack-cli": "^7.2.3"
  }
}
